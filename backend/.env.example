# Required backend settings
MONGODB_URI=your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URLS=http://localhost:3000,https://your-frontend.vercel.app

# Resend email settings for judge login credentials.
# Use an address belonging to a domain verified in Resend.
RESEND_API_KEY=re_your_api_key
MAIL_FROM=FairJudge <no-reply@your-verified-domain.com>